{
  "name": "elos",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.13.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build:resonant": "node packages/core/src/cli.ts \"Resonant DS\"",
    "preview:resonant": "node packages/react/src/preview.ts \"Resonant DS\"",
    "playground": "pnpm run build:resonant && pnpm --filter playground dev",
    "test": "node --test packages/*/src/*.test.ts apps/portal/src/lib/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "export:resonant": "node packages/react/src/export-design-system.ts \"Resonant DS\"",
    "portal": "pnpm run build:resonant && pnpm --filter portal dev"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
