{
  "color": {
    "$type": "color",
    "text": {
      "primary": { "$value": "{color.gray.900}" },
      "secondary": { "$value": "{color.gray.600}" },
      "inverse": { "$value": "{color.white}" },
      "link": { "$value": "{color.blue.600}", "$description": "Inline links" },
      "danger": { "$value": "{color.red.700}", "$description": "Error messages" }
    },
    "surface": {
      "canvas": { "$value": "{color.gray.50}", "$description": "Page background" },
      "raised": { "$value": "{color.white}", "$description": "Cards, panels" },
      "sunken": { "$value": "{color.gray.100}", "$description": "Skeletons, table header, track backgrounds" },
      "inverse": { "$value": "{color.gray.900}", "$description": "Tooltips" }
    },
    "border": {
      "subtle": { "$value": "{color.gray.200}" },
      "focus": { "$value": "{color.blue.500}" },
      "danger": { "$value": "{color.red.500}" }
    },
    "overlay": {
      "backdrop": { "$value": "{color.alpha.black-60}" }
    },
    "status": {
      "neutral": { "background": { "$value": "{color.gray.100}" }, "foreground": { "$value": "{color.gray.800}" } },
      "info": { "background": { "$value": "{color.blue.100}" }, "foreground": { "$value": "{color.blue.700}" } },
      "success": { "background": { "$value": "{color.green.100}" }, "foreground": { "$value": "{color.green.700}" } },
      "warning": { "background": { "$value": "{color.amber.100}" }, "foreground": { "$value": "{color.amber.700}" } },
      "danger": { "background": { "$value": "{color.red.100}" }, "foreground": { "$value": "{color.red.700}" } }
    },
    "action": {
      "primary": {
        "background": { "$value": "{color.blue.500}" },
        "background-hover": { "$value": "{color.blue.600}" },
        "foreground": { "$value": "{color.white}" }
      },
      "secondary": {
        "background": { "$value": "{color.gray.100}" },
        "background-hover": { "$value": "{color.gray.200}" },
        "foreground": { "$value": "{color.gray.900}" }
      },
      "ghost": {
        "background": { "$value": "{color.transparent}" },
        "background-hover": { "$value": "{color.gray.100}" },
        "foreground": { "$value": "{color.gray.900}" }
      },
      "danger": {
        "background": { "$value": "{color.red.500}" },
        "background-hover": { "$value": "{color.red.600}" },
        "foreground": { "$value": "{color.white}" }
      }
    }
  },
  "space": {
    "$type": "dimension",
    "inset": {
      "sm": { "$value": "{space.2}" },
      "md": { "$value": "{space.3}" },
      "lg": { "$value": "{space.4}" }
    },
    "stack": {
      "sm": { "$value": "{space.2}" },
      "md": { "$value": "{space.4}" },
      "lg": { "$value": "{space.6}" }
    }
  },
  "radius": {
    "$type": "dimension",
    "control": { "$value": "{radius.md}", "$description": "Buttons, inputs" },
    "container": { "$value": "{radius.lg}", "$description": "Cards, dialogs" },
    "pill": { "$value": "{radius.full}", "$description": "Badges, switches" }
  },
  "type": {
    "title": { "size": { "$type": "dimension", "$value": "{font.size.xl}" }, "weight": { "$type": "fontWeight", "$value": "{font.weight.semibold}" } },
    "heading": { "size": { "$type": "dimension", "$value": "{font.size.lg}" }, "weight": { "$type": "fontWeight", "$value": "{font.weight.semibold}" } },
    "body": { "size": { "$type": "dimension", "$value": "{font.size.md}" }, "weight": { "$type": "fontWeight", "$value": "{font.weight.regular}" } },
    "caption": { "size": { "$type": "dimension", "$value": "{font.size.sm}" }, "weight": { "$type": "fontWeight", "$value": "{font.weight.regular}" } }
  }
}
