{
  "color": {
    "$type": "color",
    "white": { "$value": "#ffffff" },
    "black": { "$value": "#0b0b0d" },
    "gray": {
      "50": { "$value": "#f7f7f8" },
      "100": { "$value": "#ececef" },
      "200": { "$value": "#d9d9df" },
      "400": { "$value": "#9a9aa6" },
      "500": { "$value": "#8a8a96" },
      "600": { "$value": "#5c5c69" },
      "800": { "$value": "#2a2a33" },
      "900": { "$value": "#1a1a21" }
    },
    "blue": {
      "100": { "$value": "#e3ecff" },
      "500": { "$value": "#3161ff" },
      "600": { "$value": "#244dd6" },
      "700": { "$value": "#1c3ca8" }
    },
    "red": {
      "100": { "$value": "#fde7e8" },
      "500": { "$value": "#e5484d" },
      "600": { "$value": "#c73b40" },
      "700": { "$value": "#a32f33" }
    },
    "green": {
      "100": { "$value": "#e1f5e8" },
      "700": { "$value": "#1f7a45" }
    },
    "amber": {
      "100": { "$value": "#fdf1d6" },
      "700": { "$value": "#9a6700" },
      "800": { "$value": "#805600" }
    },
    "alpha": {
      "black-60": { "$value": "#0b0b0d99" }
    },
    "transparent": { "$value": "#00000000" }
  },
  "space": {
    "$type": "dimension",
    "1": { "$value": { "value": 4, "unit": "px" } },
    "2": { "$value": { "value": 8, "unit": "px" } },
    "3": { "$value": { "value": 12, "unit": "px" } },
    "4": { "$value": { "value": 16, "unit": "px" } },
    "5": { "$value": { "value": 20, "unit": "px" } },
    "6": { "$value": { "value": 24, "unit": "px" } }
  },
  "radius": {
    "$type": "dimension",
    "sm": { "$value": { "value": 4, "unit": "px" } },
    "md": { "$value": { "value": 8, "unit": "px" } },
    "lg": { "$value": { "value": 12, "unit": "px" } },
    "full": { "$value": { "value": 999, "unit": "px" } }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": { "$value": "Inter, system-ui, sans-serif" },
      "mono": { "$value": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace", "$description": "Token paths, ids and code" }
    },
    "size": {
      "$type": "dimension",
      "sm": { "$value": { "value": 13, "unit": "px" } },
      "md": { "$value": { "value": 15, "unit": "px" } },
      "lg": { "$value": { "value": 17, "unit": "px" } },
      "xl": { "$value": { "value": 20, "unit": "px" } }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 }
    }
  },
  "opacity": {
    "$type": "number",
    "disabled": { "$value": 0.5 }
  },
  "border": {
    "$type": "dimension",
    "width": { "$value": { "value": 1, "unit": "px" } }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "instant": { "$value": "80ms" },
      "fast": { "$value": "150ms" },
      "base": { "$value": "220ms" },
      "slow": { "$value": "360ms" }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": { "$value": [0.2, 0, 0, 1], "$description": "Most state changes" },
      "enter": { "$value": [0, 0, 0.2, 1], "$description": "Things appearing" },
      "exit": { "$value": [0.4, 0, 1, 1], "$description": "Things leaving" }
    }
  },
  "shadow": {
    "$type": "shadow",
    "overlay": { "$value": "0 8px 24px #0b0b0d26", "$description": "Popovers, menus, toasts" }
  }
}
