{
  "color": {
    "$type": "color",
    "surface": {
      "canvas": { "$value": "{color.black}" },
      "raised": { "$value": "{color.gray.900}" },
      "sunken": { "$value": "{color.gray.800}" },
      "inverse": { "$value": "{color.gray.50}" }
    },
    "text": {
      "primary": { "$value": "{color.gray.50}" },
      "secondary": { "$value": "{color.gray.400}" },
      "inverse": { "$value": "{color.gray.900}" },
      "link": { "$value": "{color.blue.100}" },
      "danger": { "$value": "{color.red.100}" }
    },
    "border": {
      "subtle": { "$value": "{color.gray.800}" }
    },
    "status": {
      "neutral": { "background": { "$value": "{color.gray.800}" }, "foreground": { "$value": "{color.gray.50}" } },
      "info": { "background": { "$value": "{color.blue.700}" }, "foreground": { "$value": "{color.white}" } },
      "success": { "background": { "$value": "{color.green.700}" }, "foreground": { "$value": "{color.white}" } },
      "warning": { "background": { "$value": "{color.amber.700}" }, "foreground": { "$value": "{color.white}" } },
      "danger": { "background": { "$value": "{color.red.700}" }, "foreground": { "$value": "{color.white}" } }
    },
    "action": {
      "secondary": {
        "background": { "$value": "{color.gray.800}" },
        "background-hover": { "$value": "{color.gray.600}" },
        "foreground": { "$value": "{color.gray.50}" }
      },
      "ghost": {
        "background-hover": { "$value": "{color.gray.800}" },
        "foreground": { "$value": "{color.gray.50}" }
      }
    }
  }
}
