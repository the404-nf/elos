{
  "id": "ds.button",
  "name": "Button",
  "version": "0.1.0",
  "status": "draft",
  "category": "action",
  "description": "Triggers an action. One primary button per context.",
  "semantics": { "element": "button", "role": "button" },
  "props": [
    { "name": "variant", "description": "Visual prominence of the action.", "type": { "enum": ["primary", "secondary", "ghost", "danger"] }, "default": "primary" },
    { "name": "size", "description": "Control size.", "type": { "enum": ["sm", "md", "lg"] }, "default": "md" },
    { "name": "disabled", "description": "Prevents interaction.", "type": "boolean", "default": false, "attribute": "disabled" },
    { "name": "label", "description": "Visible text.", "type": "text", "required": true }
  ],
  "states": ["hover", "focus-visible", "disabled"],
  "anatomy": {
    "root": {
      "description": "Handles click, keyboard, focus and ARIA; carries variant and size.",
      "element": "button",
      "layout": { "display": "inline-flex", "align": "center", "justify": "center", "gap": "{space.inset.sm}" },
      "tokens": {
        "background-color": "{color.action.{variant}.background}",
        "color": "{color.action.{variant}.foreground}",
        "padding-inline": "{space.inset.{size}}",
        "padding-block": "{space.inset.sm}",
        "border-radius": "{radius.control}",
        "font-family": "{font.family.sans}",
        "font-size": "{font.size.{size}}",
        "font-weight": "{font.weight.medium}"
      },
      "states": {
        "hover": { "background-color": "{color.action.{variant}.background-hover}" },
        "focus-visible": { "outline-color": "{color.border.focus}" },
        "disabled": { "opacity": "{opacity.disabled}" }
      },
      "parts": {
        "label": { "description": "Concise action verb in sentence case.", "element": "span", "content": { "prop": "label" } }
      }
    }
  },
  "a11y": {
    "focusVisible": true,
    "minHitArea": 44,
    "contrast": "AA",
    "keyboard": [
      { "key": "Enter", "action": "activate" },
      { "key": "Space", "action": "activate" }
    ],
    "aria": ["aria-pressed when used as a toggle", "aria-expanded when it opens an overlay", "aria-disabled rather than disabled when focus must stay reachable"]
  },
  "usage": {
    "when": ["user must trigger an action", "submitting a form", "confirming or cancelling", "opening or closing an overlay"],
    "whenNot": ["navigating to another page", "more than one primary action in a view", "a binary setting that takes effect at once"],
    "intents": ["submit", "confirm", "cancel", "create", "delete", "retry", "open", "close"],
    "alternatives": []
  },
  "guidelines": {
    "do": ["start the label with an action verb", "keep one primary button per view", "keep hit area at least 44px", "show a visible state for hover, focus and disabled"],
    "dont": ["use vague labels like OK or Click here", "remove focus styles", "use a button for navigation", "auto-focus a danger button"]
  },
  "resources": [
    { "title": "UX Patterns for Devs: Button", "url": "https://uxpatterns.dev/patterns/forms/button" },
    { "title": "MDN: button element", "url": "https://developer.mozilla.org/docs/Web/HTML/Element/button" }
  ],
  "relationships": {
    "pairsWith": [],
    "excludes": [],
    "contains": [],
    "within": ["ds.card"]
  },
  "channels": {
    "web": { "support": "native" },
    "widget": { "support": "native" },
    "slack": { "support": "native", "as": "actions.button", "note": "danger maps to style=danger, primary to style=primary, others plain" },
    "markdown": { "support": "degraded", "as": "link or numbered option", "note": "no interaction; render label as an option the agent can act on" }
  },
  "examples": [
    { "name": "Primary", "tree": { "component": "ds.button", "props": { "label": "Save changes" } } },
    { "name": "Danger small", "tree": { "component": "ds.button", "props": { "label": "Delete", "variant": "danger", "size": "sm" } } }
  ]
}
