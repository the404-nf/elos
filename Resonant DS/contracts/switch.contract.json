{
  "id": "ds.switch",
  "name": "Switch",
  "version": "0.1.0",
  "status": "draft",
  "category": "form",
  "description": "On/off setting that takes effect at once.",
  "semantics": { "element": "label" },
  "behavior": "switch",
  "props": [
    { "name": "label", "description": "What the setting controls.", "type": "text", "required": true },
    { "name": "checked", "description": "Initial state.", "type": "boolean", "default": false },
    { "name": "disabled", "description": "Prevents changes.", "type": "boolean", "default": false },
    { "name": "name", "description": "Form field name.", "type": "text" }
  ],
  "states": ["checked", "disabled", "focus-visible"],
  "anatomy": {
    "root": {
      "description": "Label wrapping the control, so clicking the text toggles it.",
      "element": "label",
      "layout": { "display": "inline-flex", "align": "center", "gap": "{space.inset.sm}" },
      "styles": { "cursor": "pointer" },
      "states": { "disabled": { "opacity": "{opacity.disabled}" } },
      "parts": {
        "input": { "description": "Visually hidden native checkbox with role switch; carries name and form value.", "element": "input" },
        "control": {
          "description": "The track. Background shows the state.",
          "element": "span",
          "tokens": {
            "background-color": "{color.action.secondary.background}",
            "width": "{switch.track.width}",
            "height": "{switch.track.height}",
            "border-radius": "{radius.pill}"
          },
          "states": { "checked": { "background-color": "{color.action.primary.background}" } },
          "styles": { "position": "relative", "display": "inline-block", "transition": "background-color 150ms" },
          "parts": {
            "thumb": {
              "description": "Slides along the track.",
              "element": "span",
              "tokens": {
                "width": "{switch.thumb.size}",
                "height": "{switch.thumb.size}",
                "top": "{switch.thumb.offset}",
                "left": "{switch.thumb.offset}",
                "background-color": "{color.white}",
                "border-radius": "{radius.pill}"
              },
              "styles": { "position": "absolute", "display": "block", "transition": "transform 150ms" },
              "stylesByState": { "checked": { "transform": "translateX(var(--switch-thumb-travel))" } }
            }
          }
        },
        "label": {
          "description": "Visible label text.",
          "element": "span",
          "content": { "prop": "label" },
          "tokens": { "font-size": "{font.size.md}", "color": "{color.text.primary}", "font-family": "{font.family.sans}" }
        }
      }
    }
  },
  "a11y": {
    "focusVisible": true,
    "minHitArea": 44,
    "contrast": "AA",
    "keyboard": [{ "key": "Space", "action": "toggle" }],
    "aria": ["role switch with aria-checked, provided by the behavior", "the label is always visible"]
  },
  "usage": {
    "when": ["a binary setting that applies immediately"],
    "whenNot": ["a choice that needs a Save action (use a checkbox in a form)", "more than two states"],
    "intents": ["toggle", "enable", "disable", "setting", "on off"],
    "alternatives": [{ "component": "ds.button", "when": "the action is not a persistent setting" }]
  },
  "guidelines": {
    "do": ["word the label as the thing that is on when checked", "apply the change at once"],
    "dont": ["use a switch where the change needs confirmation", "put the label on the left of the control"]
  },
  "relationships": { "pairsWith": ["ds.text"], "excludes": [], "contains": [], "within": ["ds.stack", "ds.card", "ds.dialog"] },
  "channels": {
    "web": { "support": "native" },
    "widget": { "support": "native" },
    "slack": { "support": "degraded", "as": "checkboxes element with one option" },
    "markdown": { "support": "degraded", "as": "yes/no question" }
  },
  "examples": [
    { "name": "Off", "tree": { "component": "ds.switch", "props": { "label": "Dark mode" } } },
    { "name": "On", "tree": { "component": "ds.switch", "props": { "label": "Notifications", "checked": true } } },
    { "name": "Disabled", "tree": { "component": "ds.switch", "props": { "label": "Beta features", "disabled": true } } }
  ]
}
