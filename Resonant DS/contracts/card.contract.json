{
  "id": "ds.card",
  "name": "Card",
  "version": "0.1.0",
  "status": "draft",
  "category": "layout",
  "description": "Groups related content and actions on a raised surface.",
  "semantics": { "element": "article" },
  "props": [
    { "name": "title", "description": "Heading shown in the header.", "type": "text" },
    { "name": "padding", "description": "Inner spacing.", "type": { "enum": ["md", "lg"] }, "default": "md" }
  ],
  "states": [],
  "anatomy": {
    "root": {
      "description": "Raised surface with border and padding; stacks header, body and actions.",
      "element": "article",
      "layout": { "display": "flex", "direction": "column", "gap": "{space.stack.md}" },
      "tokens": {
        "background-color": "{color.surface.raised}",
        "color": "{color.text.primary}",
        "border-color": "{color.border.subtle}",
        "border-width": "{border.width}",
        "border-radius": "{radius.container}",
        "padding": "{space.inset.{padding}}",
        "font-family": "{font.family.sans}"
      },
      "parts": {
        "header": {
          "description": "Title of the group. Omit when the surrounding context already names it.",
          "element": "h3",
          "optional": true,
          "content": { "prop": "title" },
          "tokens": { "font-size": "{font.size.lg}", "font-weight": "{font.weight.semibold}" }
        },
        "body": {
          "description": "Main content. Any component or text.",
          "element": "div",
          "slot": { "acceptsMode": "open" },
          "tokens": { "font-size": "{font.size.md}", "color": "{color.text.secondary}" }
        },
        "actions": {
          "description": "Up to three buttons, trailing-aligned. One primary at most.",
          "element": "footer",
          "optional": true,
          "layout": { "display": "flex", "direction": "row", "gap": "{space.inset.sm}", "justify": "end" },
          "slot": { "accepts": ["ds.button"], "acceptsMode": "restrict", "max": 3 }
        }
      }
    }
  },
  "a11y": { "focusVisible": false, "contrast": "AA", "keyboard": [], "aria": ["use a heading element for the title so screen readers can navigate between cards"] },
  "usage": {
    "when": ["grouping a summary with its actions", "showing one item of a collection", "a report section"],
    "whenNot": ["wrapping an entire page", "nesting cards inside cards", "a single sentence that needs no grouping"],
    "intents": ["summarize", "report", "list-item", "detail", "group"],
    "alternatives": []
  },
  "guidelines": {
    "do": ["keep one topic per card", "put the primary action last in the actions slot", "use the title to name the content, not the component"],
    "dont": ["nest cards", "put more than three actions in a card", "make the whole card clickable when it also contains buttons"]
  },
  "resources": [
    { "title": "UX Patterns for Devs: Card Grid", "url": "https://uxpatterns.dev/patterns/data-display/card-grid" }
  ],
  "relationships": {
    "pairsWith": [],
    "excludes": ["ds.card"],
    "contains": ["ds.button"],
    "within": []
  },
  "channels": {
    "web": { "support": "native" },
    "widget": { "support": "native" },
    "slack": { "support": "degraded", "as": "header + section + actions blocks", "note": "no surface or border; title becomes a header block" },
    "markdown": { "support": "degraded", "as": "heading + paragraph + options", "note": "actions become a numbered list" }
  },
  "examples": [
    {
      "name": "Report summary",
      "tree": {
        "component": "ds.card",
        "props": { "title": "Weekly report" },
        "slots": {
          "body": ["12 components changed, 3 tokens added."],
          "actions": [
            { "component": "ds.button", "props": { "label": "Open report" } },
            { "component": "ds.button", "props": { "label": "Dismiss", "variant": "ghost" } }
          ]
        }
      }
    }
  ]
}
