{
  "id": "ds.card",
  "name": "Card",
  "version": "0.1.0",
  "status": "draft",
  "category": "layout",
  "description": "Groups related content and actions on a raised surface.",
  "semantics": {
    "element": "article"
  },
  "props": [
    {
      "name": "as",
      "description": "article, or a when the whole card is one link (set href; no buttons or links inside).",
      "type": {
        "enum": [
          "article",
          "a"
        ]
      },
      "default": "article"
    },
    {
      "name": "href",
      "description": "Where a link card goes.",
      "type": "text",
      "attribute": "href"
    },
    {
      "name": "title",
      "description": "Heading shown in the header.",
      "type": "text"
    },
    {
      "name": "padding",
      "description": "Inner spacing. xl (24px) is the default; lg for dense panes and sidebars.",
      "type": {
        "enum": [
          "md",
          "lg",
          "xl"
        ]
      },
      "default": "xl"
    },
    {
      "name": "heading",
      "description": "Heading level of the title, so cards follow the document outline.",
      "type": {
        "enum": [
          "h2",
          "h3"
        ]
      },
      "default": "h3"
    },
    {
      "name": "interactive",
      "description": "The whole card is one target (a link or a button): the beam runs around its border on hover and focus. No buttons inside.",
      "type": "boolean",
      "default": false
    },
    {
      "name": "tone",
      "description": "raised: a fill step above the page. glass: translucent, for tiles on the Bloom header.",
      "type": {
        "enum": [
          "raised",
          "glass"
        ]
      },
      "default": "raised"
    },
    {
      "name": "featured",
      "description": "The one featured card of a view: gradient edge and a soft glow from below.",
      "type": "boolean",
      "default": false
    }
  ],
  "states": [
    "hover",
    "focus-visible"
  ],
  "anatomy": {
    "root": {
      "description": "Raised surface with border and padding; stacks header, body and actions.",
      "element": "{as}",
      "layout": {
        "display": "flex",
        "direction": "column",
        "gap": "{space.stack.md}"
      },
      "tokens": {
        "background-color": "{color.card.{tone}.background}",
        "color": "{color.card.{tone}.foreground}",
        "border-color": "{color.card.{tone}.border}",
        "border-width": "{border.width}",
        "border-radius": "{radius.container}",
        "padding": "{space.inset.{padding}}",
        "font-family": "{font.family.sans}"
      },
      "parts": {
        "frame": {
          "description": "The beam's window: a 1.5px ring masked out of the card edge, visible only while an interactive card is hovered or focused.",
          "element": "span",
          "attributes": {
            "aria-hidden": "true"
          },
          "styles": {
            "display": "none",
            "position": "absolute",
            "inset": "0",
            "overflow": "clip",
            "padding": "1.5px",
            "pointer-events": "none",
            "opacity": "var(--card-beam, 0)",
            "-webkit-mask": "linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0)",
            "-webkit-mask-composite": "xor",
            "mask-composite": "exclude"
          },
          "tokens": {
            "border-radius": "{radius.container}"
          },
          "motion": {
            "opacity": {
              "duration": "{motion.duration.slow}",
              "easing": "{motion.easing.standard}"
            }
          },
          "stylesByProp": {
            "interactive": {
              "true": {
                "display": "block"
              }
            }
          },
          "parts": {
            "beam": {
              "description": "The light: a conic gradient that turns once per beam duration.",
              "element": "span",
              "styles": {
                "display": "block",
                "position": "absolute",
                "inset": "-100%"
              },
              "tokens": {
                "background": "{gradient.beam}"
              },
              "animation": {
                "keyframes": "turn",
                "duration": "{motion.duration.beam}",
                "easing": "{motion.easing.linear}",
                "iterations": "infinite",
                "on": "hover"
              }
            }
          }
        },
        "header": {
          "description": "Title row: the heading on the left, the meta slot (a link, a count, a toggle) on the right. Omitted when both are empty.",
          "element": "div",
          "optional": true,
          "layout": {
            "display": "flex",
            "direction": "row",
            "align": "center",
            "gap": "{space.3}"
          },
          "parts": {
            "title": {
              "description": "Title of the group. Omit when the surrounding context already names it.",
              "element": "{heading}",
              "optional": true,
              "content": {
                "prop": "title"
              },
              "tokens": {
                "font-family": "{type.heading.family}",
                "font-size": "{font.size.md}",
                "font-weight": "{type.heading.weight}",
                "letter-spacing": "{type.heading.tracking}"
              },
              "styles": {
                "margin": "0",
                "flex": "1 1 auto",
                "min-width": "0"
              }
            },
            "meta": {
              "description": "Trailing detail: a quiet link, a count or a segmented control.",
              "element": "div",
              "optional": true,
              "slot": {
                "acceptsMode": "open"
              },
              "layout": {
                "display": "flex",
                "direction": "row",
                "align": "center",
                "gap": "{space.2}"
              },
              "tokens": {
                "color": "{color.text.secondary}",
                "font-size": "{font.size.base}"
              },
              "styles": {
                "margin-left": "auto",
                "flex": "none"
              }
            }
          }
        },
        "body": {
          "description": "Main content. Any component or text.",
          "element": "div",
          "slot": {
            "acceptsMode": "open"
          },
          "tokens": {
            "font-size": "{font.size.md}",
            "color": "{color.text.secondary}"
          }
        },
        "actions": {
          "description": "Up to three buttons, trailing-aligned. One primary at most.",
          "element": "footer",
          "optional": true,
          "layout": {
            "display": "flex",
            "direction": "row",
            "gap": "{space.inset.sm}",
            "justify": "end"
          },
          "slot": {
            "accepts": [
              "ds.button"
            ],
            "acceptsMode": "restrict",
            "max": 3
          }
        }
      },
      "styles": {
        "position": "relative",
        "box-sizing": "border-box"
      },
      "stylesByProp": {
        "interactive": {
          "true": {
            "cursor": "pointer"
          }
        },
        "tone": {
          "glass": {
            "backdrop-filter": "blur(8px)"
          }
        },
        "as": {
          "a": {
            "text-decoration": "none",
            "display": "flex"
          }
        },
        "featured": {
          "true": {
            "border": "1.5px solid transparent",
            "background-image": "var(--gradient-glow), linear-gradient(var(--color-card-raised-background), var(--color-card-raised-background)), var(--gradient-edge)",
            "background-origin": "padding-box, padding-box, border-box",
            "background-clip": "padding-box, padding-box, border-box"
          }
        }
      },
      "states": {
        "focus-visible": {
          "outline-color": "{color.border.focus}"
        }
      },
      "stylesByState": {
        "hover": {
          "--card-beam": "1"
        },
        "focus-visible": {
          "--card-beam": "1"
        }
      }
    }
  },
  "a11y": {
    "focusVisible": false,
    "contrast": "AA",
    "keyboard": [],
    "aria": [
      "use a heading element for the title so screen readers can navigate between cards"
    ]
  },
  "usage": {
    "when": [
      "grouping a summary with its actions",
      "showing one item of a collection",
      "a report section"
    ],
    "whenNot": [
      "wrapping an entire page",
      "nesting cards inside cards",
      "a single sentence that needs no grouping"
    ],
    "intents": [
      "summarize",
      "report",
      "list-item",
      "detail",
      "group"
    ],
    "alternatives": []
  },
  "guidelines": {
    "do": [
      "keep one topic per card",
      "put the primary action last in the actions slot",
      "use the title to name the content, not the component"
    ],
    "dont": [
      "nest cards",
      "put more than three actions in a card",
      "make the whole card clickable when it also contains buttons",
      "put buttons or links inside an interactive card",
      "lift or shadow a card on hover: the beam is the hover",
      "feature more than one card per view"
    ]
  },
  "resources": [
    {
      "title": "UX Patterns for Devs: Card Grid",
      "url": "https://uxpatterns.dev/patterns/data-display/card-grid"
    }
  ],
  "relationships": {
    "pairsWith": [],
    "excludes": [
      "ds.card"
    ],
    "contains": [
      "ds.button"
    ],
    "within": []
  },
  "channels": {
    "web": {
      "support": "native"
    },
    "widget": {
      "support": "native"
    },
    "slack": {
      "support": "degraded",
      "as": "header + section + actions blocks",
      "note": "no surface or border; title becomes a header block"
    },
    "markdown": {
      "support": "degraded",
      "as": "heading + paragraph + options",
      "note": "actions become a numbered list"
    }
  },
  "examples": [
    {
      "name": "Report summary",
      "tree": {
        "component": "ds.card",
        "props": {
          "title": "Weekly report"
        },
        "slots": {
          "body": [
            "12 components changed, 3 tokens added."
          ],
          "actions": [
            {
              "component": "ds.button",
              "props": {
                "label": "Open report"
              }
            },
            {
              "component": "ds.button",
              "props": {
                "label": "Dismiss",
                "variant": "ghost"
              }
            }
          ]
        }
      }
    }
  ],
  "keyframes": {
    "turn": {
      "to": {
        "transform": "rotate(360deg)"
      }
    }
  }
}
