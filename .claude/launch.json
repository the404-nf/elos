{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "playground",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "playground", "dev"],
      "port": 5173
    },
    {
      "name": "portal",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "portal", "dev"],
      "port": 3000
    },
    {
      "name": "portal-3001",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "portal", "exec", "next", "dev", "-p", "3001"],
      "env": { "PGLITE_DIR": ".data/pglite-3001" },
      "port": 3001
    },
    {
      "name": "outputs",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["vite", "preview", "--outDir", "Claude outputs", "--port", "5180", "--strictPort"],
      "port": 5180
    }
  ]
}
